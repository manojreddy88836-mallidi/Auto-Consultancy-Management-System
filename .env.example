# ──────────────────────────────────────────────────────────────────────────────
# Auto Consultancy Management System — Environment Variables Template
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the real values.
# NEVER commit the .env file to Git. The .gitignore already excludes it.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/shop_management

# ── JWT (replace with a 64-character+ random string) ─────────────────────────
JWT_SECRET=replace_this_with_a_cryptographically_secure_random_string_min_64_chars
# Token lifetime in milliseconds (default: 3 600 000 = 1 hour)
JWT_EXPIRATION_MS=3600000

# ── File Uploads ──────────────────────────────────────────────────────────────
FILE_UPLOAD_DIR=./uploads

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Seed / initial admin credentials (change before first production deployment) ──
SEED_ADMIN_EMAIL=admin@yourconsultancy.com
SEED_ADMIN_PASSWORD=ReplaceWithStrongPassword@123
SEED_WORKER_PASSWORD=ReplaceWithStrongWorkerPassword@123
