# ── Render Production Environment ────────────────────────────────────────────
# Set VITE_API_BASE_URL to your Render backend service URL (NO trailing slash)
# Example: https://auto-consultancy-backend.onrender.com
#
# HOW TO SET ON RENDER:
#  1. Go to Render Dashboard → your FRONTEND service
#  2. Environment tab → Add Environment Variable
#  3. Key:   VITE_API_BASE_URL
#  4. Value: https://your-backend-service-name.onrender.com
#
# This value is baked into the frontend build at deploy time by Render.
# Without this, all API calls will fail in production.
# ─────────────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://auto-consultancy-backend-dnqt.onrender.com
